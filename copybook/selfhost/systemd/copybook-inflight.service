[Unit]
Description=Copybook tunnel in-flight sampler (cloudflared metrics every 2 s, per-minute max to ~/copybook-api/inflight.tsv; emails hello@ at 100 of the 200 limit)
After=copybook-tunnel.service

[Service]
ExecStart=%h/copybook-api/ops/inflight-sampler.sh
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
